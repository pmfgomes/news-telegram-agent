# Host path mounted to /app/data inside the container
DATA_DIR=./data

# Optional: host path for config.yaml (mounted over /app/src/config/config.yaml)
# CONFIG_FILE=./src/config/config.yaml

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Telegram — forum-enabled GROUP (topics), not a channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Aliases still accepted: TELEGRAM_CHAT_ID / TELEGRAM_CHANNEL_ID
# Optional: DM yourself on total run failure
# TELEGRAM_ALERT_CHAT_ID=

# OpenRouter
OPENROUTER_API_KEY=
# Swap freely without rebuilding, e.g. google/gemini-2.5-flash-lite or openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
