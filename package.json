{
  "name": "news-telegram-agent",
  "private": true,
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "quality": "bun run format:check && bun run lint",
    "build:newsletter-css": "bunx @tailwindcss/cli -i ./src/newsletter/input.css -o ./src/newsletter/styles.css --minify"
  },
  "dependencies": {
    "@tanstack/ai": "^0.52.1",
    "@tanstack/ai-openrouter": "^0.19.6",
    "cheerio": "^1.2.0",
    "grammy": "^1.45.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rss-parser": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
